{
  "name": "old-aleppo-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run data:build && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "serve": "npm run dev",
    "data:build": "tsx scripts/build.ts 3",
    "fetch": "tsx scripts/fetch.ts",
    "typecheck": "tsc --noEmit",
    "test:simulation": "tsx scripts/test-simulation.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.160.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
